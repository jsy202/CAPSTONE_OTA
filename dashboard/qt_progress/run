#!/usr/bin/env python3
"""Read-only native Qt viewer; does not launch or authorize updates."""
import json
import os
from pathlib import Path
import platform
import sys

output = Path(__file__).resolve().parents[2] / '.demo/progress-build'
prefix = os.environ.get('CAPSTONE_QT_PREFIX')
if prefix is None and (output / 'runtime.json').exists():
    prefix = json.loads((output / 'runtime.json').read_text())['qt_prefix']
if prefix:
    library = Path(prefix) / 'lib' / (platform.machine() + '-linux-gnu')
    os.environ['LD_LIBRARY_PATH'] = str(library) + ':' + os.environ.get('LD_LIBRARY_PATH', '')
    os.environ['QML2_IMPORT_PATH'] = str(library / 'qt5/qml')
    os.environ['QT_PLUGIN_PATH'] = str(library / 'qt5/plugins')
os.environ.setdefault('QT_QUICK_BACKEND', 'software')
if not os.environ.get('DISPLAY') and not os.environ.get('WAYLAND_DISPLAY'):
    os.environ.setdefault('QT_QPA_PLATFORM', 'offscreen')
binary = output / 'capstone-ota-progress'
if not binary.exists():
    sys.exit('Build dashboard/qt_progress/build.py first')
os.execv(str(binary), [str(binary), *sys.argv[1:]])
