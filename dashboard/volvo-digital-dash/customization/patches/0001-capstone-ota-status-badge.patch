diff -ruN a/app/app.pro b/app/app.pro
--- a/app/app.pro
+++ b/app/app.pro
@@ -499,3 +499,14 @@
 }
 
 DISTFILES +=
+
+# CAPSTONE OTA status badge and application IPC (local customization, see customization/ in CAPSTONE_OTA)
+QT += network
+SOURCES += src/capstone/app_status.cpp src/capstone/cluster_signals.cpp src/capstone/cluster_ipc_server.cpp
+HEADERS += inc/capstone/app_status.h inc/capstone/cluster_signals.h inc/capstone/cluster_ipc_server.h inc/capstone/context_model_access.h
+INCLUDEPATH += inc/capstone
+# DEMO/TEST FAULT INJECTION ONLY: qmake CAPSTONE_FAULT_SPEED_DIVISOR=10 builds a deliberately faulty Cluster.
+!isEmpty(CAPSTONE_FAULT_SPEED_DIVISOR) {
+    DEFINES += CAPSTONE_FAULT_SPEED_DIVISOR=$$CAPSTONE_FAULT_SPEED_DIVISOR
+    message("DEMO/TEST FAULT INJECTION BUILD: CAPSTONE_FAULT_SPEED_DIVISOR=$$CAPSTONE_FAULT_SPEED_DIVISOR")
+}
