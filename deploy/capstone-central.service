[Unit]
Description=CAPSTONE minimal Central application (application A/B)
After=network.target

[Service]
Type=simple
User=capstone-app
WorkingDirectory=/opt/capstone-ota-minimal/device/current
ExecStart=/opt/capstone-ota-minimal/device/current/bin/app
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
