[Unit]
Description=CAPSTONE Cluster application (separate application A/B root)
After=network.target

[Service]
Type=simple
User=capstone-app
RuntimeDirectory=capstone-cluster
RuntimeDirectoryMode=0750
UMask=0007
Environment=CAPSTONE_MODEL_SOCKET=/run/capstone-cluster/model.sock
Environment=CAPSTONE_CAN_CHANNEL=can0
WorkingDirectory=/opt/capstone-cluster/device/current
ExecStart=/opt/capstone-cluster/device/current/bin/app
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
