#!/usr/bin/env python3
"""Tiny payload to understand OTA; not the future CAN/Qt application."""
import argparse
import json
from pathlib import Path
import sys
import time


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--check", action="store_true", help="initialize normally, report readiness, exit")
    args = parser.parse_args()
    try:
        config = json.loads((Path(__file__).resolve().parents[1] / "config.json").read_text())
        if (set(config) != {"label", "period_ms"} or not isinstance(config["label"], str)
                or type(config["period_ms"]) is not int or not 10 <= config["period_ms"] <= 10000):
            raise ValueError("period_ms must be an integer from 10 through 10000")
    except (OSError, ValueError, TypeError) as exc:
        print(f"Central initialization failed: {exc}", file=sys.stderr)
        return 1
    print(json.dumps(config), flush=True)
    if args.check:
        return 0
    try:
        while True:
            time.sleep(config["period_ms"] / 1000)
    except KeyboardInterrupt:
        return 0


raise SystemExit(main())
